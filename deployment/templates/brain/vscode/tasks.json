{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Brain: dev (:8000)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "rockygpt" },
      "problemMatcher": []
    },
    {
      "label": "Brain: health check",
      "type": "shell",
      "command": "curl -s localhost:${BRAIN_PORT:-8000}/health",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Brain: typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
