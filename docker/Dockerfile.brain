# The answering engine, served over HTTP.
#
# The build context is the rockygpt-brain repository and nothing above it.
# Campus data is an HTTP dependency, so there is no sibling folder or workspace
# root to copy.

FROM node:22-slim AS build
WORKDIR /srv

# The whole repository is copied before installing, rather than the manifests
# alone. Installing runs this package's own `prepare`, and `prepare` compiles
# it, so tsconfig.build.json and src must already be here — with only the
# manifests, tsc exits on a config file that does not exist yet. It costs the
# usual dependency layer caching, which is worth less than an install that
# works.
COPY . .

# devDependencies are needed by that same install, not just by tests: `prepare`
# compiles this package with TypeScript. Installing without them fails on a missing tsc — the trap
# render.yaml documents for the deployed build.
RUN npm ci --include=dev && npm prune --omit=dev

FROM node:22-slim AS runtime
WORKDIR /srv
ENV NODE_ENV=production

COPY --from=build /srv/node_modules ./node_modules
COPY --from=build /srv/dist ./dist
COPY --from=build /srv/package.json ./package.json

# The server treats the presence of PORT as the signal to bind every interface.
# Binding loopback would answer from inside the container and fail every
# healthcheck reaching it from outside.
ENV PORT=8000
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "start"]
