# The answering engine, served over HTTP.
#
# The build context is the rockygpt-brain repository and nothing above it.
# @rockygpt/data arrives as an ordinary dependency, so there is no sibling
# folder to copy and no workspace root to install from.

FROM node:22-slim AS build
WORKDIR /srv

# Dependencies are fetched from GitHub with git, which the slim image does not
# ship. The lockfile records ssh:// URLs and a container holds no keys, so git
# is pointed at the same public repositories over https instead.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && git config --global url."https://github.com/".insteadOf "git@github.com:" \
  && git config --global url."https://github.com/".insteadOf "ssh://git@github.com/"

COPY package.json package-lock.json ./

# devDependencies are needed at install time, not just for tests: npm runs
# `prepare` for this package and for every git dependency, and `prepare`
# compiles with TypeScript. Installing without them fails on a missing tsc —
# the same trap render.yaml documents for the deployed build.
RUN npm ci --include=dev

COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-slim AS runtime
WORKDIR /srv
ENV NODE_ENV=production

COPY --from=build /srv/node_modules ./node_modules
COPY --from=build /srv/dist ./dist
COPY --from=build /srv/package.json ./package.json

# The server treats the presence of PORT as the signal to bind every interface.
# Binding loopback would answer from inside the container and fail every
# healthcheck reaching it from outside.
ENV PORT=8000
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "start"]
