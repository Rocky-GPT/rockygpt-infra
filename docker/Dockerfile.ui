# The Next.js web app. Talks to the brain over BRAIN_URL, never in process.

FROM node:22-slim AS build
WORKDIR /srv

# The build context contains only the UI repository.
COPY . .

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm ci --include=dev

# Server routes call backing services at runtime, so the build needs neither
# service URLs nor database credentials.
RUN npm run build && npm prune --omit=dev

FROM node:22-slim AS runtime
WORKDIR /srv
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=build /srv/node_modules ./node_modules
COPY --from=build /srv/.next ./.next
COPY --from=build /srv/public ./public
COPY --from=build /srv/package.json ./package.json
COPY --from=build /srv/next.config.ts ./next.config.ts
COPY --from=build /srv/lib ./lib

ENV PORT=3000
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/readiness').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "start"]
