# Campus data, served over HTTP.
#
# Two things are built here from one repository. The `runtime` stage is the
# service: compiled output only, devDependencies pruned away. The `tooling`
# stage keeps the source and tsx, because the pipeline commands are not part
# of the published build — tsconfig.build.json compiles src and api, not
# pipeline — and the schema still has to be applied from somewhere.

FROM node:22-slim AS tooling
WORKDIR /srv

# The whole repository is copied before installing, rather than the manifests
# alone. Installing runs this package's own `prepare`, and `prepare` compiles
# it, so the tsconfig and the sources must already be here — with only the
# manifests, tsc exits on a config file that does not exist yet.
COPY . .

# Playwright is a devDependency and fetches a browser on install unless told
# not to. Nothing served here drives a browser; the scrapers that do are
# scheduled work rather than part of this service.
#
# devDependencies are needed by the install itself: `prepare` compiles this
# package with TypeScript. It also
# runs build:assets, which copies the schema, its migrations, and the reference
# JSON into dist — without that every packageAsset lookup resolves to a file
# that was never emitted.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --include=dev

FROM tooling AS pruned
RUN npm prune --omit=dev

FROM node:22-slim AS runtime
WORKDIR /srv
ENV NODE_ENV=production

COPY --from=pruned /srv/node_modules ./node_modules
COPY --from=pruned /srv/dist ./dist
COPY --from=pruned /srv/package.json ./package.json

# The server treats the presence of PORT as the signal to bind every interface.
# Binding loopback would answer from inside the container and fail every
# healthcheck reaching it from outside.
ENV PORT=8100
EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:8100/readiness').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npm", "start"]
