# Compose reads this file automatically when it sits beside the compose file.
# Copy it to .env so every compose command has what it needs — the key is
# required to interpolate the stack, not only to start it, so without it even
# `docker compose ps` refuses to run.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
CHAT_LOG_HASH_KEY=replace-with-a-long-random-secret
ABUSE_HASH_KEY=replace-with-the-same-32-character-or-longer-secret-for-ui-and-brain
ADMIN_API_TOKEN=replace-with-a-long-random-secret
